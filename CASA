function getTopt(image){
  var tmean = image.select('T');
  var Topt_mean = ee.Number(
    tmean.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: geom,
      scale: 500,
      maxPixels: 1e9
    }).values().get(0)
  );
  var Topt = ee.Image(Topt_mean).rename('Topt');
  return image.addBands(Topt).clip(geom);
}

