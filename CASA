// ✅ 本地化 NDVI_min：来自 2001–2020 NDVI 统计
function set_NDVImin(image){
  var img = image;

  // Forests（1–5）
  img = img.where(img.eq(1), 0.723902);  // Evergreen Needleleaf
  img = img.where(img.eq(2), 0.02);      // Evergreen Broadleaf（本区几乎没有）
  img = img.where(img.eq(3), 0.791152);  // Deciduous Needleleaf
  img = img.where(img.eq(4), 0.840655);  // Deciduous Broadleaf
  img = img.where(img.eq(5), 0.80057);   // Mixed Forest

  // Closed Shrublands（6）
  img = img.where(img.eq(6), 0.05);

  // Open Shrublands（7）
  img = img.where(img.eq(7), 0.02);      // 原 p5 为负，抬到 0.02

  // Woody savannas / savannas
  img = img.where(img.eq(8), 0.729818);  // Woody savannas
  img = img.where(img.eq(9), 0.455844);  // Savannas

  // Grasslands
  img = img.where(img.eq(10), 0.147414);

  // Wetlands
  img = img.where(img.eq(11), 0.331067);

  // Croplands
  img = img.where(img.eq(12), 0.461628);

  // Urban and built-up
  img = img.where(img.eq(13), 0.118445);

  // Cropland/Natural mosaic
  img = img.where(img.eq(14), 0.787639);

  // Snow and ice
  img = img.where(img.eq(15), 0.02);     // 负值改为 0.02

  // Barren / Sparse
  img = img.where(img.eq(16), 0.04437);

  // Water
  img = img.where(img.eq(17), 0.02);     // 负值改 0.02，避免 FPAR 崩溃

  return img.toFloat();
}

