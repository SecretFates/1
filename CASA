function makeYearlyComposite_I(date){
  date = ee.Date(date);
  return I.filterDate(date, date.advance(1, 'year'))
          .sum()
          .set('system:index', date.format('YYYY'))
          .set('year', date.get('year'))
          .set('system:time_start', date.millis())
          .set('system:time_end',   date.advance(1, 'year').millis());
}

